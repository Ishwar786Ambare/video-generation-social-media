# Configuration Template
# Copy this file to .env and fill in your credentials

# ==========================================
# YouTube Configuration
# ==========================================
# Path to your OAuth2 credentials JSON file
# Download from: https://console.cloud.google.com/
YOUTUBE_CREDENTIALS_PATH=credentials/youtube_credentials.json

# ==========================================
# Facebook Configuration
# ==========================================
# Get your access token from: https://developers.facebook.com/
# Required permissions: pages_manage_posts, pages_read_engagement
FB_ACCESS_TOKEN=your_facebook_access_token_here

# Optional: Your Facebook Page ID (for page uploads)
FB_PAGE_ID=your_page_id_here

# ==========================================
# Instagram Configuration
# ==========================================
# Your Instagram credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# ==========================================
# Video Generation Settings
# ==========================================
# Default output directory for generated videos
OUTPUT_DIR=output_videos

# Default language for text-to-speech (ISO 639-1 code)
# Examples: en (English), es (Spanish), fr (French), de (German)
TTS_LANGUAGE=en

# Default speech speed (true for slow, false for normal)
TTS_SLOW=false

# ==========================================
# Platform-Specific Defaults
# ==========================================
# YouTube defaults
YOUTUBE_RESOLUTION_WIDTH=1920
YOUTUBE_RESOLUTION_HEIGHT=1080
YOUTUBE_FPS=30
YOUTUBE_PRIVACY=private

# Facebook defaults
FACEBOOK_RESOLUTION_WIDTH=1280
FACEBOOK_RESOLUTION_HEIGHT=720
FACEBOOK_FPS=30

# Instagram defaults
INSTAGRAM_RESOLUTION_WIDTH=1080
INSTAGRAM_RESOLUTION_HEIGHT=1080
INSTAGRAM_FPS=30

# ==========================================
# Advanced Settings
# ==========================================
# Enable debug logging
DEBUG=false

# Video encoding quality (lower = better quality, larger file)
# Range: 18-28, recommended: 23
VIDEO_CRF=23

# Background music volume (0.0 to 1.0)
BACKGROUND_MUSIC_VOLUME=0.3
